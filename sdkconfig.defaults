CONFIG_IDF_TARGET="esp32s3"

# Flash & Partition (TENSTAR ESP32-S3FH4R2 has 4MB Flash)
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# OTA Rollback Support
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_APP_ROLLBACK_ENABLE=y

# USB Serial/JTAG Console
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Default I2C Pins for esp-idf-lib/i2cdev (TENSTAR ESP32S3-1.14TFT)
CONFIG_I2CDEV_DEFAULT_SDA_PIN=42
CONFIG_I2CDEV_DEFAULT_SCL_PIN=41

# Bluetooth Low Energy (NimBLE)
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=2
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_SVC_GAP_DEVICE_NAME="Ripple-Buoy"

# NimBLE Buffer & MTU optimizations for BLE OTA throughput
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=512
CONFIG_BT_NIMBLE_MSYS1_BLOCK_COUNT=32
CONFIG_BT_NIMBLE_MSYS2_BLOCK_COUNT=32
